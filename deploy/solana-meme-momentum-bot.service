[Unit]
Description=Solana Meme Momentum Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/solana-meme-momentum-bot
ExecStart=/opt/solana-meme-momentum-bot/.venv/bin/python -m src.main
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
