SOLANA_RPC_URL=
# Base58-encoded private key of a dedicated burner wallet. Never your main wallet.
SOLANA_PRIVATE_KEY=

# Safety: keep true until you have verified behavior. No live swaps are sent while true.
DRY_RUN=true

TRADE_CURRENCY=USDC
POSITION_SIZE_USD=100
GAS_RESERVE_SOL=0.5
SLIPPAGE_BPS=300

PUMP_WINDOW_MINUTES=15
PUMP_THRESHOLD_PCT=15
TAKE_PROFIT_PCT=8
STOP_LOSS_PCT=3

POLL_INTERVAL_SECONDS=60
SCAN_CONCURRENCY=8
SCAN_RATE_LIMIT_PER_SECOND=5

DB_PATH=positions.db
DASHBOARD_PORT=8090
DASHBOARD_HOST=127.0.0.1
# Set to protect the dashboard when exposing it beyond localhost. Open the
# dashboard once with ?key=<value> appended to the URL; the browser remembers
# it via cookie after that, no login prompt needed again.
DASHBOARD_ACCESS_KEY=
